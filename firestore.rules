rules_version = '2';

// Reglas de seguridad para la colección de huecos reservados.
// Pega esto en: Consola de Firebase → Firestore Database → pestaña "Reglas".
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Es el equipo de SDJ? Cualquier usuario con sesión iniciada en Firebase
    // Auth: las cuentas las creas tú a mano en la consola (no hay registro).
    function esAdmin() { return request.auth != null; }

    match /slots/{slotId} {
      // Cualquiera puede LEER la disponibilidad (para pintar el calendario).
      allow read: if true;

      // Solo se puede CREAR un hueco si no existe ya.
      // Esto evita que dos personas reserven la misma franja a la vez:
      // la segunda escritura falla porque el documento ya existe.
      allow create: if !exists(/databases/$(database)/documents/slots/$(slotId));

      // Borra el hueco el panel, o el cliente que ha cancelado su reserva
      // (la autorización quedó registrada en /liberaciones con su código).
      allow update: if esAdmin();
      allow delete: if esAdmin() || exists(/databases/$(database)/documents/liberaciones/$(slotId));
    }

    // Códigos de cancelación. El id ES el código secreto que se le da al
    // cliente: solo puede leerlo quien lo conoce (get sí, list no). No guarda
    // datos personales.
    match /cancelaciones/{codigo} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if true;
      // El cliente solo puede: marcarla como cancelada, o pedir un cambio
      // (que queda pendiente de que el equipo lo apruebe en /admin).
      allow update: if esAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelada', 'canceladaEl']) &&
          request.resource.data.cancelada == true &&
          resource.data.cancelada == false
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cambio', 'cambioPedidoEl']) &&
          request.resource.data.cambio.estado == 'pendiente' &&
          resource.data.cancelada == false
        );
    }

    // Autorización para liberar una franja: se crea al cancelar y solo se
    // acepta si el código aportado corresponde a esa misma franja.
    match /liberaciones/{slotId} {
      allow read: if esAdmin();
      allow create: if exists(/databases/$(database)/documents/cancelaciones/$(request.resource.data.codigo))
        && get(/databases/$(database)/documents/cancelaciones/$(request.resource.data.codigo)).data.slotId == slotId;
      allow update, delete: if esAdmin();
    }

    // Partidas extraordinarias abiertas desde el panel (id = fecha AAAA-MM-DD).
    // Cualquiera las lee para pintar el calendario; solo el equipo las crea o
    // las quita.
    match /extraordinarias/{fecha} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Textos de los avisos al cliente, editables desde el panel. Solo los usa
    // el equipo, asi que ni se leen ni se escriben desde fuera de /admin.
    match /plantillas_aviso/{motivo} {
      allow read, write: if esAdmin();
    }

    // Registro de reservas (email, nombre, teléfono, etc.). Contiene datos
    // personales: el navegador SOLO puede CREAR, nunca leer/editar/borrar.
    // Tú lo consultas desde la consola de Firebase.
    match /reservas/{reservaId} {
      allow create: if true;
      // El panel de gestión (/admin) lee y actualiza el estado y las notas.
      allow read: if esAdmin();
      // El panel edita libremente; el cliente solo puede cancelar la suya, y
      // únicamente si aporta el código de cancelación que se le entregó.
      allow update: if esAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladaPor', 'codigoUsado']) &&
        request.resource.data.estado == 'cancelada' &&
        request.resource.data.codigoUsado == resource.data.codigoCancelacion
      );
      // Borrado definitivo desde la papelera del panel.
      allow delete: if esAdmin();
    }

    // Contador diario por persona (email + fecha + nº), para el límite de
    // 2 reservas por día. Datos mínimos; se puede leer y actualizar.
    match /reservas_contador/{contadorId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Contador mensual por persona (email + mes + nº), para el límite de
    // 4 reservas al mes.
    match /reservas_contador_mes/{contadorId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Lista de usuarios bloqueados (id = email). El navegador solo LEE, para
    // comprobar si un email está vetado. Se añaden/quitan desde la consola.
    match /usuarios_bloqueados/{email} {
      allow read: if true;
      allow write: if false;
    }
  }
}
